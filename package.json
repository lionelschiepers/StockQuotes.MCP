{
  "name": "stockquotes-mcp",
  "version": "1.0.8",
  "description": "MCP Server for fetching stock quotes from Yahoo Finance",
  "author": "Lionel Schiepers <lionel_schiepers@hotmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lionelschiepers/StockQuotes.MCP.git"
  },
  "bugs": {
    "url": "https://github.com/lionelschiepers/StockQuotes.MCP/issues"
  },
  "homepage": "https://github.com/lionelschiepers/StockQuotes.MCP#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "bin": {
    "stockquotes-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "npm run build -- --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "check": "npm run lint && npm run format:check",
    "fix": "npm run lint:fix && npm run format",
    "test": "jest",
    "test:coverage": "npm test -- --coverage",
    "test:watch": "npm test -- --watch",
    "start": "node dist/index.js",
    "start:stdio": "npm start -- --transport stdio",
    "start:http": "npm start -- --transport http --http-host localhost",
    "dev": "tsx watch src/index.ts --transport stdio",
    "clean": "rm -rf dist",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector node dist/index.js",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "publish:dry": "npm publish --dry-run"
  },
  "keywords": [
    "mcp",
    "stock-quotes",
    "yahoo-finance",
    "mcp-server",
    "ai-tools",
    "financial data",
    "finance",
    "api"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@stockquotes/core": "file:../StockQuotes.API/packages/stockquotes-core",
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "node-cache": "^5.1.2",
    "winston": "^3.19.0",
    "yahoo-finance2": "^4.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
